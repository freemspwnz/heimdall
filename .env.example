GIGACHAT_CREDENTIALS=
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_CHAT_MODEL=GigaChat-3-Ultra
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_VERIFY_SSL=true

# Host (uv run on the machine): use 127.0.0.1
# Compose (guest on lab network): use Docker DNS names of lab services
LOKI_URL=http://127.0.0.1:3100
VICTORIAMETRICS_URL=http://127.0.0.1:8428
# Unix socket only (tcp:// Docker hosts are not supported)
DOCKER_HOST=unix:///var/run/docker.sock
POSTGRES_DSN=postgresql://heimdall:heimdall@127.0.0.1:5432/heimdall
KNOWLEDGE_DIR=docs/knowledge
# LangGraph HITL checkpoints (local file — not Postgres/Redis; see README)
CHECKPOINT_PATH=heimdall-checkpoints.sqlite

# Compose examples (uncomment / adapt to your lab service names):
# LOKI_URL=http://loki:3100
# VICTORIAMETRICS_URL=http://victoriametrics:8428
# POSTGRES_DSN=postgresql://heimdall:heimdall@postgres:5432/heimdall
# HEIMDALL_LAB_NETWORK=lab
# HEIMDALL_IMAGE_TARGET=embeddings
# CHECKPOINT_PATH=/data/heimdall-checkpoints.sqlite
# KNOWLEDGE_DIR=/app/docs/knowledge

EMBEDDER=local
LOCAL_EMBEDDER_MODEL=intfloat/multilingual-e5-base

HEIMDALL_LISTEN=0.0.0.0:8080
HEIMDALL_URL=http://127.0.0.1:8080
